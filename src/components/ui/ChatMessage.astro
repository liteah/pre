---
const { type } = Astro.props
---

<div
  class:list={[
    'flex items-center relative p-3 rounded-xl text-pretty',
    type === 'user'
      ? 'justify-end bg-primary text-background ms-auto max-w-[75%]'
      : type === 'assistant'
        ? 'justify-start bg-muted text-foreground'
        : 'text-muted-foreground',
  ]}
>
  <slot />
</div>
