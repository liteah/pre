---
import { useTranslations } from '@/utils/i18n'

const t = useTranslations(Astro.currentLocale)
---

<div class="max-h-screen py-24 sm:py-32">
  <div class="container mx-auto flex flex-col items-center justify-center">
    <p class="text-h3 text-gradient-primary mb-4">PRE OS 6</p>
    <h1 class="text-h1">
      {t({ en: 'New Feel, Smart Always.', 'zh-cn': '质感全开，智感自来', 'zh-tw': '質感全開，智感自來' })}
    </h1>
  </div>
  <img
    src="/background/os-6-hero.webp"
    alt="Background image"
    class="absolute inset-0 -z-10 size-full object-cover object-bottom mask-b-from-85%"
  />
</div>
