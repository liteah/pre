---
import ChatMessage from '@/components/ui/ChatMessage.astro'
import { useTranslations } from '@/utils/i18n'

const t = useTranslations(Astro.currentLocale)
// Memory is the ability to store and retrieve information. It is the ability to remember things.
---

<div class="section-card flex flex-col gap-8">
  <div>
    <span text-h6 text-gradient-ai>{t({ en: 'AI Bookmarks', 'zh-cn': 'AI收藏', 'zh-tw': 'AI收藏' })}</span>
    <h2 class="text-h2 sm:text-h3 mt-2">
      {
        t({
          en: 'AI sorts it, summarizes it, and has it ready when you are.',
          'zh-cn': '一键收藏，AI替你分门别类，摘要也写好。',
          'zh-tw': '隨手收藏，AI幫你自動歸檔，重點能看完。',
        })
      }
      <!-- {
        t({
          en: "Don't just save it. Savor it.",
          'zh-cn': '你的收藏，不必吃灰。',
          'zh-tw': '你的收藏，不必再積灰塵。',
        })
      } -->
    </h2>
    <p text-caption text-balance mt-2>
      {
        t({
          en: 'When adding to global bookmarks, content is automatically categorized and summarized.',
          'zh-cn': '新增全局收藏时，会自动根据内容归类并添加摘要。',
          'zh-tw': '新增全域收藏時，會自動根據內容歸類並新增摘要。',
        })
      }
    </p>
  </div>
  <div class="flex flex-col">
    <div class="relative bg-secondary p-4 rounded-xl">
      <p class="font-medium">
        {
          t({
            en: 'Chef\’s Tips: New-York-Style Bagel with Lox',
            'zh-cn': '厨师长教你：「蛋炒饭」的家常做法',
            'zh-tw': '主廚教你：「蛋炒飯」的家常做法',
          })
        }
      </p>
      <p class="text-sm text-secondary-foreground text-pretty">
        {
          t({
            en: 'The chef shows how to build the perfect bagel: toast an everything bagel until crisp, smear with scallion cream cheese, layer hand-sliced Nova lox, add tomato, red onion, capers and a crack of black pepper. Key: keep the lox cold, the bagel warm, and assemble just before serving for the ideal contrast.',
            'zh-cn':
              '厨师长演示家常蛋炒饭，先将鸡蛋炒散，加米饭翻炒至粒粒分明，放少许盐和生抽调味，撒葱花出锅。强调用隔夜饭、少油、大火快炒，米饭蓬松。',
            'zh-tw':
              '主廚示範家常蛋炒飯：先將雞蛋炒散，再加入米飯翻炒至粒粒分明，加少許鹽和生抽調味，最後撒蔥花起鍋。重點是用隔夜飯、少油、大火快炒，米飯鬆軟。',
          })
        }
      </p>
      <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-background px-2 py-1 rounded-full">
        {
          t({
            en: 'Added to "Cooking Tutorials"',
            'zh-cn': '已收纳到「烹饪教程」',
            'zh-tw': '已收納到「烹飪教程」',
          })
        }
      </span>
    </div>
  </div>
</div>
