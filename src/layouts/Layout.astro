---
const locale = Astro.currentLocale
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>PRE</title>
  </head>
  <body class="antialiased mx-auto">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    text-autospace: normal;
  }
</style>

{
  locale === 'en' ? (
    <style>
      @import
      url('https://fonts.googleapis.cn/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
    </style>
  ) : locale === 'zh-cn' ? (
    <style>@import url("https://fontsapi.zeoseven.com/389/main/result.css");</style>
  ) : locale === 'zh-tw' ? (
    <style>@import url("https://font.emtech.cc/css/IBMPlexSansTC");</style>
  ) : null
}
