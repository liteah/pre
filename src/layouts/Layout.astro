---
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import { config } from '@/config'
import { locales } from '@/i18n.config'

const { title, class: className } = Astro.props
const locale = Astro.currentLocale
---

<!doctype html>
<html lang={locales[locale as string].lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} | ${config.name}` : config.name}</title>
  </head>
  <body class="antialiased mx-auto text-foreground select-text selection:bg-primary/30">
    <Header />
    <main class:list={['min-h-screen', className]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    text-autospace: normal;
  }
</style>

{
  locale === 'en' ? (
    <style>
      @import
      url('https://fonts.googleapis.cn/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
    </style>
  ) : locale === 'zh-cn' ? (
    <style>@import url("https://font.emtech.cc/css/IBMPlexSansSC");</style>
  ) : locale === 'zh-tw' ? (
    <style>@import url("https://font.emtech.cc/css/IBMPlexSansTC");</style>
  ) : null
}
